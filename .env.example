# ============================================================================
# CONFIGURAÇÕES DE AMBIENTE - New StartSE
# ============================================================================
# Copie este arquivo para .env e configure as variáveis conforme necessário

# --- Django ---
SECRET_KEY=django-insecure-TROQUE-POR-UMA-CHAVE-SEGURA
DEBUG=True

# --- Banco de Dados (PostgreSQL - Opcional) ---
# DATABASE_URL:
# SQLite (Local): sqlite:///db.sqlite3
# PostgreSQL (Local): postgres://user:password@localhost:5432/dbname
# PostgreSQL (Neon/Supabase): postgres://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3
DB_SSL_REQUIRE=False
# DB_NAME=startse_db
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# OPÇÕES DE IA - Escolha UMA das opções abaixo
# ============================================================================

# --- OPÇÃO 1: Ollama (Open Source - Local) ---
# Instalação: https://ollama.ai/download
# Após instalar, execute: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- OPÇÃO 2: Google Gemini (API) ---
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=sua_chave_api_aqui

# ============================================================================
# API DE VALIDAÇÃO DE CNPJ (Opcional)
# ============================================================================
# A validação de CNPJ usa a Brasil API (gratuita) por padrão.
# Se quiser usar uma API paga, configure aqui:
# API_DADOS_CNPJ_KEY=sua_chave_api_aqui

# ============================================================================
# ASSINATURA DIGITAL - ZapSign
# ============================================================================
# Obtenha sua chave em: https://app.zapsign.com.br/
# ZAPSIGN_API_TOKEN=seu_token_aqui
# ZAPSIGN_TEMPLATE_ID=id_do_template_de_contrato

# ============================================================================
# ASSINATURA DIGITAL - Clicksign (Alternativa)
# ============================================================================
# Obtenha sua chave em: https://www.clicksign.com/
# CLICKSIGN_API_KEY=sua_chave_aqui

# ============================================================================
# AZURE STORAGE - Data Room (Produção)
# ============================================================================
# Para armazenamento seguro de documentos confidenciais
# AZURE_STORAGE_ACCOUNT_NAME=sua_conta_storage
# AZURE_STORAGE_ACCOUNT_KEY=sua_chave_storage
# AZURE_STORAGE_CONTAINER_NAME=dataroom

