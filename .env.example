# ============================================================================
# CONFIGURAÇÕES DE AMBIENTE - New StartSE
# ============================================================================
# Copie este arquivo para .env e configure as variáveis conforme necessário

# --- Django ---
SECRET_KEY=django-insecure-TROQUE-POR-UMA-CHAVE-SEGURA
DEBUG=True

# --- Banco de Dados (PostgreSQL - Opcional) ---
# DATABASE_URL=postgres://usuario:senha@localhost:5432/startse_db
# DB_NAME=startse_db
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================================
# OPÇÕES DE IA - Escolha UMA das opções abaixo
# ============================================================================

# --- OPÇÃO 1: Ollama (Open Source - Local) ---
# Instalação: https://ollama.ai/download
# Após instalar, execute: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- OPÇÃO 2: Google Gemini (API) ---
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=sua_chave_api_aqui
